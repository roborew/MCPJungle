# Local multi-stage build for MCPJungle.
#
# The upstream Dockerfile in this repo expects a GoReleaser-produced
# `mcpjungle` binary in the build context. This file produces that binary
# locally and packages it into a stdio-capable runtime image (Node + uvx
# available so registered stdio MCP servers continue to work).

FROM node:20-bookworm AS dashboard
WORKDIR /src
COPY web/dashboard/package.json web/dashboard/package-lock.json* web/dashboard/
COPY assets ./assets
COPY web/dashboard ./web/dashboard
WORKDIR /src/web/dashboard
RUN npm ci --no-audit --no-fund
RUN npm run build
RUN rm -rf /src/internal/dashboardui/dist \
 && mkdir -p /src/internal/dashboardui/dist \
 && cp -R dist/. /src/internal/dashboardui/dist/

FROM golang:1.24.3-bookworm AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=dashboard /src/internal/dashboardui/dist /src/internal/dashboardui/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mcpjungle .

FROM ghcr.io/astral-sh/uv:debian
LABEL org.opencontainers.image.source="https://github.com/roborew/MCPJungle"
LABEL org.opencontainers.image.description="MCPJungle - local build with simplified lazy MCP loading"
LABEL org.opencontainers.image.title="MCPJungle (local)"
LABEL org.opencontainers.image.vendor="mcpjungle"

RUN apt-get update \
 && apt-get install -y curl gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y nodejs \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=gobuild /out/mcpjungle /mcpjungle

EXPOSE 8080
ENTRYPOINT ["/mcpjungle"]
CMD ["start"]